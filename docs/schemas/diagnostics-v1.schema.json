          ]
        },
        "outside_percentage": {
          "type": [
            "number",
            "null"
          ]
        },
        "mean_miss_width": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "raggedSums": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "butterfly_checked_nodes",
        "butterfly_violating_nodes",
        "butterfly_skipped_smiles",
        "butterfly_min_g",
        "calendar_checked_points",
        "calendar_violating_points",
        "calendar_skipped_pairs",
        "smile_count",
        "node_count",
        "duplicate_group_count",
        "collapsed_duplicate_points",
        "max_duplicate_iv_range",
        "nonpositive_total_variance_points",
