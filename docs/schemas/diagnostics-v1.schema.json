{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raeidsaqur.github.io/fast-vollib/schemas/diagnostics-v1.schema.json",
  "title": "fast-vollib diagnostics-v1",
  "description": "Reproducible implied-volatility surface diagnostics: fit error, spread consistency, sampled-smile arbitrage counts, and rectangular-grid summaries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "config",
    "record_count",
    "records_included",
    "records",
    "summaries"
  ],
  "properties": {
    "schema": {
      "const": "diagnostics-v1"
    },
    "config": {
      "$ref": "#/$defs/config"
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "records_included": {
      "type": "boolean"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "summaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/summary"
      }
    }
  },
  "$defs": {
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "complement_name",
        "k_min",
        "k_max",
        "T_min",
        "T_max",
        "closed"
      ],
      "properties": {
        "kind": {
          "const": "box"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "complement_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "k_min": {
          "type": [
            "number",
            "null"
          ]
        },
        "k_max": {
          "type": [
            "number",
            "null"
          ]
        },
        "T_min": {
          "type": [
            "number",
            "null"
          ]
        },
        "T_max": {
          "type": [
            "number",
            "null"
          ]
        },
        "closed": {
          "enum": [
            "both",
            "left",
            "right",
            "neither"
          ]
        }
      }
    },
    "raggedConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maturity_decimals",
        "butterfly_min_unique_strikes",
        "calendar_min_unique_strikes",
        "calendar_grid_points",
        "butterfly_tolerance",
        "calendar_tolerance",
        "duplicates"
      ],
      "properties": {
        "maturity_decimals": {
          "type": "integer"
        },
        "butterfly_min_unique_strikes": {
          "type": "integer"
        },
        "calendar_min_unique_strikes": {
          "type": "integer"
        },
        "calendar_grid_points": {
          "type": "integer"
        },
        "butterfly_tolerance": {
          "type": "number"
        },
        "calendar_tolerance": {
          "type": "number"
        },
        "duplicates": {
          "enum": [
            "mean_total_variance",
            "error"
          ]
        }
      }
    },
    "errorSums": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "squared_error_sum",
        "absolute_error_sum",
        "valid_prediction_count",
        "target_count",
        "invalid_prediction_count",
        "max_absolute_error"
      ],
      "properties": {
        "squared_error_sum": {
          "type": "number"
        },
        "absolute_error_sum": {
          "type": "number"
        },
        "valid_prediction_count": {
          "type": "integer"
        },
        "target_count": {
          "type": "integer"
        },
        "invalid_prediction_count": {
          "type": "integer"
        },
        "max_absolute_error": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "errorSumsWithDerived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "squared_error_sum",
        "absolute_error_sum",
        "valid_prediction_count",
        "target_count",
        "invalid_prediction_count",
        "max_absolute_error",
        "rmse",
        "mae",
        "coverage",
        "invalid_rate"
      ],
      "properties": {
        "squared_error_sum": {
          "type": "number"
        },
        "absolute_error_sum": {
          "type": "number"
        },
        "valid_prediction_count": {
          "type": "integer"
        },
        "target_count": {
          "type": "integer"
        },
        "invalid_prediction_count": {
          "type": "integer"
        },
        "max_absolute_error": {
          "type": [
            "number",
            "null"
          ]
        },
        "rmse": {
          "type": [
            "number",
            "null"
          ]
        },
        "mae": {
          "type": [
            "number",
            "null"
          ]
        },
        "coverage": {
          "type": [
            "number",
            "null"
          ]
        },
        "invalid_rate": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "spreadSums": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_quote_count",
        "priced_quote_count",
        "unpriced_quote_count",
        "midpoint_squared_error_sum",
        "outside_count",
        "outside_width_sum"
      ],
      "properties": {
        "eligible_quote_count": {
          "type": "integer"
        },
        "priced_quote_count": {
          "type": "integer"
        },
        "unpriced_quote_count": {
          "type": "integer"
        },
        "midpoint_squared_error_sum": {
          "type": "number"
        },
        "outside_count": {
          "type": "integer"
        },
        "outside_width_sum": {
          "type": "number"
        }
      }
    },
    "spreadSumsWithDerived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_quote_count",
        "priced_quote_count",
        "unpriced_quote_count",
        "midpoint_squared_error_sum",
        "outside_count",
        "outside_width_sum",
        "price_rmse",
        "outside_percentage",
        "mean_miss_width"
      ],
      "properties": {
        "eligible_quote_count": {
          "type": "integer"
        },
        "priced_quote_count": {
          "type": "integer"
        },
        "unpriced_quote_count": {
          "type": "integer"
        },
        "midpoint_squared_error_sum": {
          "type": "number"
        },
        "outside_count": {
          "type": "integer"
        },
        "outside_width_sum": {
          "type": "number"
        },
        "price_rmse": {
          "type": [
            "number",
