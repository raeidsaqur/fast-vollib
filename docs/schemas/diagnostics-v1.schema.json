        "max_maturity_bucket_span": {
          "type": [
            "number",
            "null"
          ]
        },
        "butterfly_percentage": {
          "type": [
            "number",
            "null"
          ]
        },
        "calendar_percentage": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "gridSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "sas",
        "ndm",
        "ndm_mean",
        "butterfly_fraction",
        "calendar_fraction",
        "calendar_depth_max",
        "vertical_fraction",
        "bound_fraction",
        "violation_count",
        "native_violation_counts",
        "interpolation_induced_violation_counts",
        "quoted_coverage",
        "native_coverage",
        "strike_count",
        "maturity_count",
        "tolerance"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "sas": {
          "type": "number"
        },
        "ndm": {
          "type": "number"
        },
        "ndm_mean": {
          "type": "number"
        },
        "butterfly_fraction": {
          "type": "number"
        },
        "calendar_fraction": {
          "type": "number"
        },
        "calendar_depth_max": {
          "type": "number"
        },
        "vertical_fraction": {
          "type": "number"
        },
        "bound_fraction": {
          "type": "number"
        },
        "violation_count": {
          "type": "integer"
        },
        "native_violation_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "interpolation_induced_violation_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "quoted_coverage": {
          "type": "number"
        },
        "native_coverage": {
          "type": "number"
        },
        "strike_count": {
          "type": "integer"
        },
        "maturity_count": {
          "type": "integer"
        },
        "tolerance": {
          "type": "number"
        }
      }
    },
    "gridGroupSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count",
        "passed_count",
        "sas_max",
        "sas_mean",
        "ndm_max",
        "butterfly_fraction_max",
        "calendar_fraction_max",
        "vertical_fraction_max",
        "bound_fraction_max",
        "native_coverage_min"
      ],
      "properties": {
        "sample_count": {
          "type": "integer"
        },
        "passed_count": {
          "type": "integer"
        },
        "sas_max": {
          "type": "number"
        },
        "sas_mean": {
          "type": "number"
        },
        "ndm_max": {
          "type": "number"
