        "fit": {
          "$ref": "#/$defs/fit"
        },
        "spread": {
          "oneOf": [
            {
              "$ref": "#/$defs/spreadSums"
            },
            {
              "type": "null"
            }
          ]
        },
        "ragged": {
          "oneOf": [
