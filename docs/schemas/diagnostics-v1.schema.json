            },
            {
              "type": "null"
            }
          ]
        },
        "quality_status": {
          "enum": [
            "complete",
            "partial"
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "split",
        "sample_count",
        "fit",
        "spread",
        "ragged",
        "ragged_butterfly_sample_mean",
        "ragged_calendar_sample_mean",
        "quality_status",
        "grid"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "type": "string",
          "minLength": 1
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "fit": {
          "$ref": "#/$defs/fitWithDerived"
        },
        "spread": {
          "oneOf": [
            {
              "$ref": "#/$defs/spreadSumsWithDerived"
            },
            {
              "type": "null"
            }
          ]
        },
        "ragged": {
          "oneOf": [
