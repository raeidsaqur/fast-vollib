      "properties": {
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/box"
          }
        },
        "ragged": {
          "$ref": "#/$defs/raggedConfig"
        },
        "metadata": {
          "type": "object"
        }
      }
    }
