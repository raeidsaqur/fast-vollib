    "regionErrors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "complement_name",
        "descriptor",
        "inside",
        "outside"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "complement_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "descriptor": {
          "$ref": "#/$defs/box"
        },
        "inside": {
          "$ref": "#/$defs/errorSums"
        },
        "outside": {
          "oneOf": [
            {
              "$ref": "#/$defs/errorSums"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "regionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "complement_name",
        "descriptor",
        "inside",
        "outside"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "complement_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "descriptor": {
          "$ref": "#/$defs/box"
        },
        "inside": {
          "$ref": "#/$defs/errorSumsWithDerived"
        },
        "outside": {
          "oneOf": [
            {
              "$ref": "#/$defs/errorSumsWithDerived"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "fit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall",
        "regions"
      ],
      "properties": {
        "overall": {
          "$ref": "#/$defs/errorSums"
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/regionErrors"
          }
        }
      }
    },
    "fitWithDerived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall",
        "regions"
      ],
      "properties": {
        "overall": {
          "$ref": "#/$defs/errorSumsWithDerived"
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/regionSummary"
          }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "split",
        "sample_id",
        "fit",
        "spread",
        "ragged",
        "grid",
        "quality_status"
