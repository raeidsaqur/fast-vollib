        "butterfly_violating_nodes": {
          "type": "integer"
        },
        "butterfly_skipped_smiles": {
          "type": "integer"
        },
        "butterfly_min_g": {
          "type": [
            "number",
            "null"
          ]
        },
        "calendar_checked_points": {
          "type": "integer"
        },
        "calendar_violating_points": {
          "type": "integer"
        },
        "calendar_skipped_pairs": {
          "type": "integer"
        },
        "smile_count": {
          "type": "integer"
        },
        "node_count": {
          "type": "integer"
        },
        "duplicate_group_count": {
          "type": "integer"
        },
        "collapsed_duplicate_points": {
          "type": "integer"
        },
        "max_duplicate_iv_range": {
          "type": [
            "number",
            "null"
          ]
        },
        "nonpositive_total_variance_points": {
          "type": "integer"
        },
        "unusable_points": {
          "type": "integer"
        },
        "max_maturity_bucket_span": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "raggedSumsWithDerived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "butterfly_checked_nodes",
        "butterfly_violating_nodes",
        "butterfly_skipped_smiles",
        "butterfly_min_g",
        "calendar_checked_points",
        "calendar_violating_points",
        "calendar_skipped_pairs",
        "smile_count",
        "node_count",
        "duplicate_group_count",
        "collapsed_duplicate_points",
        "max_duplicate_iv_range",
        "nonpositive_total_variance_points",
        "unusable_points",
        "max_maturity_bucket_span",
        "butterfly_percentage",
        "calendar_percentage"
      ],
      "properties": {
        "butterfly_checked_nodes": {
          "type": "integer"
        },
        "butterfly_violating_nodes": {
          "type": "integer"
        },
        "butterfly_skipped_smiles": {
          "type": "integer"
